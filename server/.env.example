# Copie ce fichier sous le nom .env (jamais poussé sur GitHub) puis remplis-le.

PORT=3000

# Chaîne de connexion Atlas. Remplace MOT_DE_PASSE par celui de bonberrybahire_db_user.
# « crispyvision » (avant le ?) est le nom de la base : MongoDB la crée tout seul.
MONGODB_URI=mongodb+srv://bonberrybahire_db_user:MOT_DE_PASSE@crispy-vision.hjy7xbw.mongodb.net/crispyvision?retryWrites=true&w=majority&appName=crispy-vision

# Sites autorisés à envoyer le formulaire (séparés par des virgules, sans / à la fin).
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500,https://slimb-hash.github.io

# Générés par : npm run secrets
ADMIN_PASSWORD_HASH=
JWT_SECRET=

# Courriel de notification (optionnel : laisse vide pour l'instant)
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
NOTIFY_EMAIL=
